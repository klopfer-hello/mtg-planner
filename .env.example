# Copy to .env and fill in. Never commit .env.

# Claude subscription token for the planner chat. Create it with
#   claude setup-token
# on any machine where Claude Code is logged into your Claude subscription
# (Pro/Max), then paste the printed token here. Without it the app works,
# only the planner chat is disabled.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude Code CLI version. The CLI is not part of the image: on start the
# container installs this version from npm into the /claude volume (once per
# version; needs network access to registry.npmjs.org). Unset or empty = the
# version pinned in the image. If the install fails the app still starts, only
# the chat and the scanner's Claude fallback are unavailable (see /healthz
# claude_cli).
# CLAUDE_CODE_VERSION=2.1.296

# Optional model override passed to `claude --model` (e.g. "sonnet", "opus").
# Empty = Claude Code's default for your subscription.
CLAUDE_MODEL=

# Max. Claude CLI processes running at once (one per chat turn).
CLAUDE_MAX_CONCURRENT=2

# Hard timeout for one chat turn in milliseconds.
CLAUDE_TIMEOUT_MS=600000

# Host port the app is published on (docker-compose.yml).
MTG_PLANNER_PORT=8080

# --- Card scanner -----------------------------------------------------------
# All optional; the defaults are deliberately conservative.

# Max. Claude vision calls per hour for scans the local engine (OCR + index +
# fingerprint) can't settle. Uses the same subscription token and the same
# CLAUDE_MAX_CONCURRENT gate as the chat. 0 disables the Claude fallback;
# empty = the default (60).
SCAN_CLAUDE_PER_HOUR=60

# Spend cap per vision call (--max-budget-usd) and its timeout.
CLAUDE_SCAN_MAX_BUDGET_USD=0.25
CLAUDE_SCAN_TIMEOUT_MS=90000

# Scans identified at the same time; more uploads get HTTP 429 until one finishes.
SCAN_MAX_CONCURRENT=2

# How long a scan waits for the fingerprint matcher's warm-up after a start
# before it goes on without the fingerprint.
SCAN_MATCHER_WAIT_MS=30000

# Model for the vision fallback (passed to `claude --model`).
CLAUDE_SCAN_MODEL=sonnet

# JSON overrides for single decision thresholds (see README "Scanner" and
# lib/scanner.js DEFAULT_THRESHOLDS). Empty = built-in defaults. Example:
#   SCAN_THRESHOLDS={"fpAuto":0.27,"titleAuto":0.7}
SCAN_THRESHOLDS=

# On start with an empty card index, download Scryfall's bulk data and then
# build the image fingerprints in the background (~78k images, about two
# hours, ~1.2 GB). An unfinished fingerprint job resumes after a restart.
# Set to false to start these jobs by hand from the Import tab.
SCAN_AUTO_INDEX=true

# Keep the downloaded reference images under /data/images so a future
# fingerprint change only re-hashes instead of re-downloading (~1.2 GB).
FP_KEEP_IMAGES=true

# Comma-separated set codes to restrict the fingerprint job to (testing only).
# Empty = all sets.
FP_INDEX_SETS=
# Build the card index from a local all_cards .jsonl.gz instead of downloading it.
# INDEX_BULK_SOURCE=/data/all-cards.jsonl.gz

# The same printing+finish scanned again within this window (ms) is not staged
# automatically; the app offers "+1" instead.
SCAN_DUPLICATE_WINDOW_MS=20000

# --- Backups ----------------------------------------------------------------
# Manual backups (Import tab → Backup & restore) of the app data. Directory
# inside the container (default: next to the database, /data/backups) and how
# many manual backups to keep (pre-restore safety backups: the last 5).
# BACKUP_DIR=/data/backups
BACKUP_KEEP=20

# --- Nightly maintenance ----------------------------------------------------
# A scheduler checks every 15 minutes; inside INDEX_REFRESH_HOUR it refreshes
# the scanner's card index (only when it is older than INDEX_REFRESH_DAYS and
# Scryfall has published newer bulk data, then updates the fingerprints) and
# the prices of owned and deck cards (when older than PRICE_REFRESH_DAYS).

# false disables the scheduler (refresh by hand from the Import tab).
SCHEDULER_ENABLED=true

# Hour of day (0-23, container local time, see TZ) for the maintenance window.
INDEX_REFRESH_HOUR=4

# Minimum age in days before the card index / the prices are refreshed.
INDEX_REFRESH_DAYS=7
PRICE_REFRESH_DAYS=7

# Container time zone (IANA name) for INDEX_REFRESH_HOUR. Unset = UTC.
# TZ=Europe/Berlin
