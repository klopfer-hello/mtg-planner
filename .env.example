# Copy to .env and fill in. Never commit .env.

# Claude subscription token for the planner chat. Create it with
#   claude setup-token
# on any machine where Claude Code is logged into your Claude subscription
# (Pro/Max), then paste the printed token here. Without it the app works,
# only the planner chat is disabled.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional model override passed to `claude --model` (e.g. "sonnet", "opus").
# Empty = Claude Code's default for your subscription.
CLAUDE_MODEL=

# Max. Claude CLI processes running at once (one per chat turn).
CLAUDE_MAX_CONCURRENT=2

# Hard timeout for one chat turn in milliseconds.
CLAUDE_TIMEOUT_MS=600000

# Host port the app is published on (docker-compose.yml).
MTG_PLANNER_PORT=8080
